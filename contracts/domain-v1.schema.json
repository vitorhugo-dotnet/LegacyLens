{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legacylens.local/contracts/domain-v1.schema.json",
  "title": "LegacyLens shared domain version 1",
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "column"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "root", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" },
        "root": { "type": "string" },
        "includes": { "type": ["array", "null"], "items": { "type": "string" } },
        "excludes": { "type": ["array", "null"], "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "digest", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" },
        "digest": { "type": "string", "minLength": 1 }, "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "revisionId", "path", "language", "origin", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" },
        "revisionId": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 }, "origin": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string" }
      }
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "revisionId", "artifactId", "path", "qualifiedName", "descriptor", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" },
        "revisionId": { "$ref": "#/$defs/id" }, "artifactId": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 }, "qualifiedName": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string" }, "kind": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fromId", "kind", "evidenceIds", "resolution", "layer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fromId": { "$ref": "#/$defs/id" },
        "toId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "resolution": { "enum": ["resolved", "dynamic", "unresolved"] },
        "layer": { "enum": ["static", "observed"] },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "traceId", "producerId", "sequence", "eventId", "kind", "occurredAt"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "traceId": { "type": "string", "pattern": "^[a-fA-F0-9]{32}$" },
        "producerId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "eventId": { "$ref": "#/$defs/id" },
        "parentEventId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "pattern": "\\S" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "applicationRevision": { "$ref": "#/$defs/id" },
        "javaDestination": { "$ref": "#/$defs/id" },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" }, "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "traceId", "occurredAt", "eventIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "projectId": { "$ref": "#/$defs/id" },
        "traceId": { "type": "string", "pattern": "^[a-fA-F0-9]{32}$" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "eventIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "startedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "incomplete": { "type": "boolean" }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "message", "severity", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }, "severity": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" }, "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/project" }, { "$ref": "#/$defs/revision" },
    { "$ref": "#/$defs/artifact" }, { "$ref": "#/$defs/symbol" },
    { "$ref": "#/$defs/location" }, { "$ref": "#/$defs/relation" },
    { "$ref": "#/$defs/evidence" }, { "$ref": "#/$defs/interaction" },
    { "$ref": "#/$defs/trace" }, { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/diagnostic" }
  ]
}
