{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legacylens.local/contracts/protocol-v1.schema.json",
  "title": "LegacyLens protocol version 1",
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "diagnosticIds"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "diagnosticIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "pattern": "^[a-fA-F0-9]{32}$" },
    "page": { "type": "object", "additionalProperties": false, "required": ["items", "offset", "limit", "total", "hasMore"], "properties": { "items": { "type": "array" }, "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 }, "total": { "type": "integer", "minimum": 0 }, "hasMore": { "type": "boolean" } } },
    "projectPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/project" } } } }] },
    "artifactPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/artifact" } } } }] },
    "symbolPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/symbol" } } } }] },
    "relationPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/relation" } } } }] },
    "evidencePage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/evidence" } } } }] },
    "diagnosticPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/diagnostic" } } } }] },
    "eventPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/event" } } } }] },
    "stringPage": { "allOf": [{ "$ref": "#/$defs/page" }, { "properties": { "items": { "type": "array", "items": { "type": "string" } } } }] },
    "projectListResult": { "$ref": "#/$defs/projectPage" },
    "searchResult": { "type": "object", "additionalProperties": false, "required": ["symbols", "total", "offset", "limit", "hasMore"], "properties": { "symbols": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/symbol" } }, "total": { "type": "integer", "minimum": 0 }, "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 }, "hasMore": { "type": "boolean" } } },
    "indexResult": { "type": "object", "required": ["projectId", "revisionId", "artifacts", "symbols", "relations", "evidence", "diagnostics", "replacedFiles", "excludedFiles"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "revisionId": { "$ref": "#/$defs/nonEmptyString" }, "artifacts": { "$ref": "#/$defs/artifactPage" }, "symbols": { "$ref": "#/$defs/symbolPage" }, "relations": { "$ref": "#/$defs/relationPage" }, "evidence": { "$ref": "#/$defs/evidencePage" }, "diagnostics": { "$ref": "#/$defs/diagnosticPage" }, "replacedFiles": { "$ref": "#/$defs/stringPage" }, "excludedFiles": { "$ref": "#/$defs/stringPage" } } },
    "graphResult": { "type": "object", "required": ["symbols", "relations"], "properties": { "symbols": { "$ref": "#/$defs/symbolPage" }, "relations": { "$ref": "#/$defs/relationPage" } } },
    "impactPath": { "type": "object", "additionalProperties": false, "required": ["sourceId", "targetId", "symbolIds", "relationIds", "evidenceIds"], "properties": { "sourceId": { "$ref": "#/$defs/nonEmptyString" }, "targetId": { "$ref": "#/$defs/nonEmptyString" }, "symbolIds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonEmptyString" } }, "relationIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }, "inferred": { "type": "boolean" } } },
    "graphDiagnostic": { "type": "object", "additionalProperties": false, "required": ["id", "code", "message"], "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "code": { "$ref": "#/$defs/nonEmptyString" }, "message": { "$ref": "#/$defs/nonEmptyString" }, "symbolIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "relationId": { "$ref": "#/$defs/nonEmptyString" }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "location": { "$ref": "domain-v1.schema.json#/$defs/location" } } },
    "impactResult": { "type": "object", "additionalProperties": false, "required": ["projectId", "revisionId", "symbols", "relations", "paths", "evidence", "diagnostics", "depth", "offset", "limit", "total", "hasMore", "truncated"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "revisionId": { "$ref": "#/$defs/nonEmptyString" }, "symbols": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/symbol" } }, "relations": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/relation" } }, "paths": { "type": "array", "items": { "$ref": "#/$defs/impactPath" } }, "evidence": { "type": "array", "items": { "$ref": "domain-v1.schema.json#/$defs/evidence" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/graphDiagnostic" } }, "depth": { "type": "integer", "minimum": 0, "maximum": 16 }, "offset": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1, "maximum": 200 }, "total": { "type": "integer", "minimum": 0 }, "hasMore": { "type": "boolean" }, "truncated": { "type": "boolean" } } },
    "investigationResult": { "type": "object", "required": ["project", "trace", "agentStatus", "events", "diagnostics", "symbols", "relations", "evidence"], "properties": { "project": { "$ref": "domain-v1.schema.json#/$defs/project" }, "trace": { "$ref": "domain-v1.schema.json#/$defs/trace" }, "agentStatus": { "type": "object", "required": ["state"], "properties": { "state": { "enum": ["unknown", "online", "offline"] }, "evidenceDiagnosticId": { "$ref": "#/$defs/nonEmptyString" } } }, "indexedRevisionId": { "$ref": "#/$defs/nonEmptyString" }, "events": { "$ref": "#/$defs/eventPage" }, "diagnostics": { "$ref": "#/$defs/diagnosticPage" }, "symbols": { "$ref": "#/$defs/symbolPage" }, "relations": { "$ref": "#/$defs/relationPage" }, "evidence": { "$ref": "#/$defs/evidencePage" } } },
    "projectRegisterPayload": { "type": "object", "additionalProperties": false, "required": ["root"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "root": { "$ref": "#/$defs/nonEmptyString" }, "name": { "type": "string" }, "includes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "excludes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } } } },
    "pageRequestFields": { "type": "object", "properties": { "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 } } },
    "projectStatusPayload": { "type": "object", "additionalProperties": false, "required": ["projectId"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" } } },
    "projectIndexPayload": { "type": "object", "additionalProperties": false, "required": ["projectId"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "paths": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 } } },
    "symbolSearchPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "text"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "revisionId": { "$ref": "#/$defs/nonEmptyString" }, "text": { "type": "string" }, "kinds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 }, "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 } } },
    "graphExplorePayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "symbolIds", "depth"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "revisionId": { "$ref": "#/$defs/nonEmptyString" }, "symbolIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }, "depth": { "type": "integer", "minimum": 0, "maximum": 16 }, "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 } } },
    "impactQueryPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "symbolId", "depth", "offset", "limit"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "revisionId": { "$ref": "#/$defs/nonEmptyString" }, "symbolId": { "$ref": "#/$defs/nonEmptyString" }, "depth": { "type": "integer", "minimum": 0, "maximum": 16 }, "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 } } },
    "captureStartPayload": { "type": "object", "additionalProperties": false, "required": ["projectId"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "tabId": { "type": "string" } } },
    "captureStopPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "traceId"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "traceId": { "$ref": "#/$defs/traceId" } } },
    "traceIngestPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "events"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "events": { "type": "array", "maxItems": 10000, "items": { "$ref": "domain-v1.schema.json#/$defs/event" } } } },
    "investigationPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "traceId"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "traceId": { "$ref": "#/$defs/traceId" }, "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 } } },
    "locationOpenPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "location"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "location": { "$ref": "domain-v1.schema.json#/$defs/location" } } },
    "explanationPayload": { "type": "object", "additionalProperties": false, "required": ["projectId", "traceId", "question"], "properties": { "projectId": { "$ref": "#/$defs/nonEmptyString" }, "traceId": { "$ref": "#/$defs/traceId" }, "question": { "$ref": "#/$defs/nonEmptyString" } } },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "command", "payload"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "command": {
          "enum": ["project.register", "project.list", "project.status", "project.index", "symbol.search", "graph.explore", "impact.query", "capture.start", "capture.stop", "trace.ingest", "investigation.get", "location.open", "explanation.preview", "explanation.generate"]
        },
        "payload": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [{ "required": ["result"] }, { "required": ["error"] }]
    }
  },
  "allOf": [
    { "if": { "required": ["command"], "properties": { "command": { "const": "project.list" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/projectListResult" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "project.index" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/indexResult" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "symbol.search" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/searchResult" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "graph.explore" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/graphResult" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "impact.query" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/impactResult" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "investigation.get" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/investigationResult" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "project.register" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/projectRegisterPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "project.list" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "properties": { "offset": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "limit": { "type": "integer", "minimum": 0, "maximum": 200 } } } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "project.status" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/projectStatusPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "project.index" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/projectIndexPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "symbol.search" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/symbolSearchPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "graph.explore" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/graphExplorePayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "impact.query" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/impactQueryPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "capture.start" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/captureStartPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "capture.stop" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/captureStopPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "trace.ingest" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/traceIngestPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "investigation.get" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/investigationPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "const": "location.open" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/locationOpenPayload" } } } },
    { "if": { "required": ["command"], "properties": { "command": { "enum": ["explanation.preview", "explanation.generate"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/explanationPayload" } } } }
  ],
  "$ref": "#/$defs/envelope"
}
